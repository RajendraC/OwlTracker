<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The one sensitive permission: read bank, card and UPI SMS. Asked for only after an in-app explanation. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Reading SMS implies phone hardware; tablets and Chromebooks can still install and use manual mode. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- App lock with fingerprint, face or device PIN. Not a runtime prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Privacy by construction: no internet access, even if a library asks for it. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

